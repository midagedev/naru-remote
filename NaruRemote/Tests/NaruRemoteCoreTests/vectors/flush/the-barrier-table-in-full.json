{
  "suite": "flush",
  "id": "the-barrier-table-in-full",
  "source": {
    "repo": "naru-remote",
    "file": "NaruRemote/Tests/NaruRemoteCoreTests/AccessoryControlFlushBarrierTests.swift",
    "tests": [
      "testMarkedCompositionIsCommittedBeforeControlEmission",
      "testFlushFailureDropsControlAndDoesNotEmit",
      "testMarkedThenFailedFlushStillDropsControl",
      "testNoMarkedTextAndNoPendingFlushEmitsImmediately"
    ]
  },
  "steps": [
    {
      "t": 0,
      "in": {
        "op": "control",
        "key": "escape",
        "hasMarked": true,
        "pending": "succeeded"
      },
      "expect": {
        "intents": [
          {
            "op": "commit-marked"
          },
          {
            "op": "emit-key",
            "key": "escape",
            "mods": []
          }
        ]
      }
    },
    {
      "t": 1,
      "in": {
        "op": "control",
        "key": "escape",
        "hasMarked": false,
        "pending": "failed"
      },
      "expect": {
        "intents": [
          {
            "op": "drop-control"
          }
        ]
      }
    },
    {
      "t": 2,
      "in": {
        "op": "control",
        "key": "escape",
        "hasMarked": true,
        "pending": "failed"
      },
      "expect": {
        "intents": [
          {
            "op": "commit-marked"
          },
          {
            "op": "drop-control"
          }
        ]
      }
    },
    {
      "t": 3,
      "in": {
        "op": "control",
        "key": "escape",
        "hasMarked": false,
        "pending": "not-needed"
      },
      "expect": {
        "intents": [
          {
            "op": "emit-key",
            "key": "escape",
            "mods": []
          }
        ]
      }
    }
  ],
  "note": "commit-marked always comes first. An app whose text insertion cannot fail passes 'not-needed' forever and never sees rows 2 and 3."
}
