{
  "suite": "sticky",
  "id": "single-tap-arms-only-that-slot",
  "source": {
    "repo": "naru-remote",
    "file": "NaruRemote/Tests/NaruRemoteCoreTests/StickyModifierStateTests.swift",
    "tests": [
      "testSingleTapArmsModifier",
      "testEachSlotTransitionsIndependently"
    ]
  },
  "steps": [
    {
      "t": 0,
      "in": {
        "op": "tap",
        "mod": "control"
      },
      "expect": {
        "slots": {
          "control": "armed",
          "shift": "idle",
          "alt": "idle",
          "meta": "idle"
        },
        "active": [
          "control"
        ]
      }
    },
    {
      "t": 10,
      "in": {
        "op": "tap",
        "mod": "shift"
      },
      "expect": {
        "slots": {
          "control": "armed",
          "shift": "armed"
        },
        "active": [
          "control",
          "shift"
        ]
      }
    },
    {
      "t": 10,
      "in": {
        "op": "tap",
        "mod": "alt"
      },
      "expect": {
        "slots": {
          "alt": "armed",
          "meta": "idle"
        },
        "active": [
          "control",
          "alt",
          "shift"
        ]
      }
    }
  ]
}
