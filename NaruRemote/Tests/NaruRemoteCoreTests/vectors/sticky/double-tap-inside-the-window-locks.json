{
  "suite": "sticky",
  "id": "double-tap-inside-the-window-locks",
  "source": {
    "repo": "naru-remote",
    "file": "NaruRemote/Tests/NaruRemoteCoreTests/StickyModifierStateTests.swift",
    "tests": [
      "testDoubleTapWithin400MillisLocks"
    ]
  },
  "steps": [
    {
      "t": 0,
      "in": {
        "op": "tap",
        "mod": "shift"
      },
      "expect": {
        "slots": {
          "shift": "armed"
        }
      }
    },
    {
      "t": 200,
      "in": {
        "op": "tap",
        "mod": "shift"
      },
      "expect": {
        "slots": {
          "shift": "locked"
        },
        "active": [
          "shift"
        ]
      }
    }
  ]
}
