{
  "suite": "sticky",
  "id": "a-locked-modifier-survives-many-emissions",
  "source": {
    "repo": "naru-remote",
    "file": "NaruRemote/Tests/NaruRemoteCoreTests/StickyModifierStateTests.swift",
    "tests": [
      "testLockedModifierAppliesToManySequentialEmissions"
    ]
  },
  "steps": [
    {
      "t": 0,
      "in": {
        "op": "tap",
        "mod": "shift"
      },
      "expect": {
        "slots": {
          "shift": "armed"
        }
      }
    },
    {
      "t": 50,
      "in": {
        "op": "tap",
        "mod": "shift"
      },
      "expect": {
        "slots": {
          "shift": "locked"
        }
      }
    },
    {
      "t": 60,
      "in": {
        "op": "consume"
      },
      "expect": {
        "slots": {
          "shift": "locked"
        },
        "active": [
          "shift"
        ]
      }
    },
    {
      "t": 70,
      "in": {
        "op": "consume"
      },
      "expect": {
        "slots": {
          "shift": "locked"
        },
        "active": [
          "shift"
        ]
      }
    },
    {
      "t": 80,
      "in": {
        "op": "consume"
      },
      "expect": {
        "slots": {
          "shift": "locked"
        },
        "active": [
          "shift"
        ]
      }
    },
    {
      "t": 10050,
      "in": {
        "op": "tap",
        "mod": "shift"
      },
      "expect": {
        "slots": {
          "shift": "idle"
        }
      }
    },
    {
      "t": 10060,
      "in": {
        "op": "consume"
      },
      "expect": {
        "active": []
      }
    }
  ],
  "note": "Double-tap Shift, type three letters all held — the reason lock exists at all."
}
