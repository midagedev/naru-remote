{
  "suite": "sticky",
  "id": "consume-spends-armed-and-spares-locked",
  "source": {
    "repo": "naru-remote",
    "file": "NaruRemote/Tests/NaruRemoteCoreTests/StickyModifierStateTests.swift",
    "tests": [
      "testConsumeReleasesArmedSlotsOnly",
      "testConsumeIsNoOpWhenAllSlotsIdle"
    ]
  },
  "steps": [
    {
      "t": 0,
      "in": {
        "op": "tap",
        "mod": "control"
      },
      "expect": {
        "slots": {
          "control": "armed"
        }
      }
    },
    {
      "t": 0,
      "in": {
        "op": "tap",
        "mod": "shift"
      },
      "expect": {
        "slots": {
          "shift": "armed"
        }
      }
    },
    {
      "t": 50,
      "in": {
        "op": "tap",
        "mod": "shift"
      },
      "expect": {
        "slots": {
          "shift": "locked"
        },
        "active": [
          "control",
          "shift"
        ]
      }
    },
    {
      "t": 60,
      "in": {
        "op": "consume"
      },
      "expect": {
        "slots": {
          "control": "idle",
          "shift": "locked",
          "alt": "idle"
        },
        "active": [
          "shift"
        ]
      }
    },
    {
      "t": 70,
      "in": {
        "op": "clear"
      },
      "expect": {
        "active": []
      }
    },
    {
      "t": 80,
      "in": {
        "op": "consume"
      },
      "expect": {
        "active": []
      },
      "note": "consume with everything idle is a no-op, not an error"
    }
  ]
}
