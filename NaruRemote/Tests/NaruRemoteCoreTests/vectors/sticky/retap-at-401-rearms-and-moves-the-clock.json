{
  "suite": "sticky",
  "id": "retap-at-401-rearms-and-moves-the-clock",
  "source": {
    "repo": "naru-remote",
    "file": "NaruRemote/Tests/NaruRemoteCoreTests/StickyModifierStateTests.swift",
    "tests": [
      "testReTapAfter401MillisStaysArmedAndUpdatesTimestamp"
    ]
  },
  "steps": [
    {
      "t": 0,
      "in": {
        "op": "tap",
        "mod": "alt"
      },
      "expect": {
        "slots": {
          "alt": "armed"
        }
      }
    },
    {
      "t": 401,
      "in": {
        "op": "tap",
        "mod": "alt"
      },
      "expect": {
        "slots": {
          "alt": "armed"
        }
      },
      "note": "outside the window: a fresh single tap, not a failed lock"
    },
    {
      "t": 601,
      "in": {
        "op": "tap",
        "mod": "alt"
      },
      "expect": {
        "slots": {
          "alt": "locked"
        }
      },
      "note": "within 400 of the SECOND tap — so the timestamp must have moved"
    }
  ]
}
