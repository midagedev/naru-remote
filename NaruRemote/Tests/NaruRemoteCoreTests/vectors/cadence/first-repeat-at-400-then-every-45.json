{
  "suite": "cadence",
  "id": "first-repeat-at-400-then-every-45",
  "source": {
    "repo": "naru-remote",
    "file": "NaruRemote/Tests/NaruRemoteCoreTests/AccessoryKeyRepeatCadenceTests.swift",
    "tests": [
      "testFirstRepeatFiresAtExactly400msThenEvery45ms"
    ]
  },
  "steps": [
    {
      "t": 0,
      "in": {
        "op": "press",
        "key": "arrowRight"
      },
      "expect": {
        "intents": [
          {
            "op": "emit-key",
            "key": "arrowRight",
            "mods": []
          },
          {
            "op": "schedule-tick",
            "atMs": 400
          }
        ]
      }
    },
    {
      "t": 400,
      "in": {
        "op": "tick"
      },
      "expect": {
        "intents": [
          {
            "op": "emit-key",
            "key": "arrowRight",
            "mods": []
          },
          {
            "op": "schedule-tick",
            "atMs": 445
          }
        ]
      }
    },
    {
      "t": 445,
      "in": {
        "op": "tick"
      },
      "expect": {
        "intents": [
          {
            "op": "emit-key",
            "key": "arrowRight",
            "mods": []
          },
          {
            "op": "schedule-tick",
            "atMs": 490
          }
        ]
      }
    },
    {
      "t": 500,
      "in": {
        "op": "release"
      },
      "expect": {
        "intents": [
          {
            "op": "clear-schedule"
          }
        ],
        "held": null
      }
    },
    {
      "t": 600,
      "in": {
        "op": "tick"
      },
      "expect": {
        "intents": []
      },
      "note": "a timer that fires after release emits nothing"
    }
  ]
}
