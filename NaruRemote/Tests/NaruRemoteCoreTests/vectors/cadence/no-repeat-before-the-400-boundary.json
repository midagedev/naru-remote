{
  "suite": "cadence",
  "id": "no-repeat-before-the-400-boundary",
  "source": {
    "repo": "naru-remote",
    "file": "NaruRemote/Tests/NaruRemoteCoreTests/AccessoryKeyRepeatCadenceTests.swift",
    "tests": [
      "testNoRepeatBefore400msBoundary"
    ]
  },
  "steps": [
    {
      "t": 0,
      "in": {
        "op": "press",
        "key": "arrowDown"
      },
      "expect": {
        "intents": [
          {
            "op": "emit-key",
            "key": "arrowDown",
            "mods": []
          },
          {
            "op": "schedule-tick",
            "atMs": 400
          }
        ]
      }
    },
    {
      "t": 399,
      "in": {
        "op": "tick"
      },
      "expect": {
        "intents": [
          {
            "op": "schedule-tick",
            "atMs": 400
          }
        ]
      },
      "note": "an early timer must re-report the deadline, not emit — platform timers are approximate and a machine that emitted on any tick would turn jitter into a double keystroke"
    }
  ]
}
