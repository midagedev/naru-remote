{
  "suite": "composition",
  "id": "a-stray-commit-still-lands",
  "source": {
    "repo": "gadak",
    "file": "mobile/src/lib/terminal/ime.test.ts",
    "tests": [
      "compositionend with no preceding start does not throw and does not stick composing",
      "a stray commit still lands and an update does not latch (a-stray-commit-still-lands)"
    ]
  },
  "steps": [
    {
      "t": 0,
      "in": {
        "op": "compose-end",
        "text": "x"
      },
      "expect": {
        "composing": false,
        "intents": [
          {
            "op": "emit-text",
            "text": "x",
            "mods": []
          }
        ]
      },
      "note": "some platforms omit the start event; refusing this loses a real character"
    },
    {
      "t": 10,
      "in": {
        "op": "compose-update",
        "text": "ㅎ"
      },
      "expect": {
        "composing": false,
        "intents": [
          {
            "op": "withhold"
          }
        ]
      },
      "note": "an update must NOT latch the gate, or an update without a start wedges it open forever"
    },
    {
      "t": 20,
      "in": {
        "op": "plain",
        "text": "y"
      },
      "expect": {
        "composing": false,
        "intents": [
          {
            "op": "emit-text",
            "text": "y",
            "mods": []
          }
        ]
      }
    }
  ]
}
