.DS_Store
Thumbs.db
*.tmp
*.swp
*.log
.env*

# Apple/Xcode local state
DerivedData/
*.xcuserdata/
*.xcuserstate
*.moved-aside

# Xcode project is generated by xcodegen — do not commit
NaruRemote.xcodeproj/

# UX audit thumbnails are generated locally for vision review
artifacts/screenshots/ux-audit-thumb/

# Local-Mac E2E screenshots may capture the developer's desktop wallpaper
# / window contents.  Generated by `LocalMacConnectE2EUITests` against a
# live VNC endpoint.
artifacts/screenshots/local-mac-e2e/

# SwiftPM local build output
.build/
.swiftpm/
*.swiftpm/
Packages/

# Local agent/private state. Keep checked-in skills under .agents/skills.
.agents/**/*.local.*
.agents/**/secrets*
.agents/**/.env*

# Editor local state
.vscode/
.idea/

# Release UI audit — keep organized contact sheets, drop bulky raw frames
artifacts/release-audit/*
!artifacts/release-audit/contact-light.png
!artifacts/release-audit/contact-dark.png
